# Copy this file to .env and fill in your values
# Keys are in Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of the deployed site, embedded in confirmation/reset email links.
# It must be reachable from any device (e.g. a phone opening the email).
# Falls back to https://rezonants.com when unset.
VITE_SITE_URL=

# AI Chatbot configuration (backend only - Hugging Face Open-Source Model)
HF_TOKEN=
AI_PROVIDER=
AI_MODEL=
AI_FALLBACK_MODELS=
AI_BASE_URL=

# Google Cloud Translation API key (backend only — never exposed to browser)
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=
